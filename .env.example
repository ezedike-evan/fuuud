# Walrus Memory — generate both at https://staging.memory.walrus.xyz
#
# ONE NETWORK, END TO END. Gas for account setup is sponsored by the relayer
# (through Enoki), so users need no SUI - but the relayer, NEXT_PUBLIC_SUI_NETWORK
# and the Enoki key must all be on the same network:
#   testnet:  MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz  NEXT_PUBLIC_SUI_NETWORK=testnet
#   mainnet:  MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz          NEXT_PUBLIC_SUI_NETWORK=mainnet
# Package id comes from the relayer's /config. MEMWAL_REGISTRY_ID must match the
# network (both checked onchain: each is an AccountRegistry of that network's package):
#   testnet MEMWAL_REGISTRY_ID=0x736aef9906798fca4460490ccdf8e8502ef170122dc26ecae32111b78c6b42dd
#   mainnet MEMWAL_REGISTRY_ID=0x8bf82c9e09e36b8d1c38298f68b7cb68e7b8762887e7592add9986d5e9cf199f
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing the network.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz

# Embedding distance above which a recalled memory is treated as noise and kept
# out of the prompt. Default 0.6. Raise it if the agent is missing facts it
# should know; lower it if unrelated entries are reaching the model. Distances
# are not portable across relayer versions, so this is a dial, not a constant.
KM_RELEVANCE_DISTANCE=

# Sui contract ids for delegate-key registration (from the Walrus Memory dashboard)
MEMWAL_PACKAGE_ID=
MEMWAL_REGISTRY_ID=

# Each person creates their OWN MemWal account at /setup (their wallet signs; the
# server only ever holds a revocable delegate key). The MEMWAL_PRIVATE_KEY /
# MEMWAL_ACCOUNT_ID pair above then serves only scripts and the MCP server.
# Set to 1 ONLY for a single-tenant demo where one server-held account serves
# every visitor - the model that makes "you own your memory" false.
MEMWAL_SHARED_ACCOUNT=

# Enoki zkLogin — https://portal.enoki.mystenlabs.com
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Model provider. This one key is the OPERATOR'S FALLBACK, spent on your account
# for any visitor who has not added their own. It is optional. Every person can add
# their own key for any provider (Anthropic, OpenAI, Google, xAI, Groq) and pick
# their own model in Settings. THEIR key is always the one used: they do not have to
# mark it active, and neither this key nor KM_MODEL_PROVIDER can override it.
GROQ_API_KEY=
KM_MODEL_PROVIDER=

# Model overrides. By default ONE model does both jobs: it answers the person
# and it reads each turn for facts worth remembering. They used to be split,
# and a gate running on a model nobody chose failed silently on every turn.
# Set KM_EXTRACT_MODEL only if you want the cheap tier back for the gate.
# KM_CHAT_MODEL and KM_EXTRACT_MODEL apply to YOUR key only; a visitor using their own key
# gets their own model choice or that provider's default.
KM_CHAT_MODEL=
KM_EXTRACT_MODEL=

# Session cookie signing key — any long random string
SESSION_SECRET=

# MCP server: OPTIONAL. The owner address is read from MEMWAL_ACCOUNT_ID (the account
# on Sui records its own owner). Set this only to override that.
KM_OWNER_ADDRESS=

# The origin the browser actually loads the app from. Enoki sends
# "<this>/signin" to Google as the OAuth redirect_uri, and Google matches it
# verbatim against the registered list. Leave blank locally to use the current
# origin; set it in deployments where the public URL differs.
NEXT_PUBLIC_APP_URL=

# Sui network for zkLogin. Must be the same value the Enoki wallet is
# registered with and the one the server verifies proofs against — a testnet
# proof checked against mainnet is rejected as an invalid signature.
# Defaults to testnet when unset.
NEXT_PUBLIC_SUI_NETWORK=testnet

# Reminders — the one small non-Walrus store (chat id, push subscription, queued
# meal names + times). Upstash Redis REST, or Vercel's KV integration (same
# variables). Without these dev uses process memory and production refuses.
# Use the MAIN REST token. Upstash also shows a READ_ONLY one: with that, reminders and
# connected apps fail with "NOPERM this user has no permissions to run the 'set' command".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram — direct Bot API. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; registered with setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Web Push — `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Scheduler: .github/workflows/reminders.yml calls GET /api/cron/reminders with
# "Authorization: Bearer $CRON_SECRET". Set the same value as a repo secret.
CRON_SECRET=

# Hosted MCP connector - lets Claude, ChatGPT, Cursor, VS Code and other AI apps
# connect once with OAuth. Needs the Upstash store above.
#
# The public https origin: no path, no trailing slash. Read at RUNTIME (unlike
# NEXT_PUBLIC_*, which is baked in at build). The connector URL is APP_URL + /api/mcp
# and must be byte-for-byte what people type into their AI app.
APP_URL=
# Seals client ids, connector keys and tokens. At least 32 characters:
#   openssl rand -hex 32
# To rotate, put the NEW value in OAUTH_SECRET and the old one in OAUTH_SECRET_PREVIOUS.
OAUTH_SECRET=
OAUTH_SECRET_PREVIOUS=
# Extra redirect URIs for other AI apps, comma separated. Built in: Claude, ChatGPT,
# Cursor, VS Code. Anything else must be listed here or it cannot register.
OAUTH_REDIRECT_ALLOW=
# Localhost redirects, used by Claude Code, Gemini CLI and the MCP Inspector. 0 turns them off.
OAUTH_ALLOW_LOOPBACK=1

# --- SEO and public pages (all optional) ---
# Search Console / Bing Webmaster verification tokens (the content="" value of the meta tag they give you).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Shown on /privacy and /terms. Without it those pages point to the repository's issue tracker.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Voice (dictation on the website, voice notes on Telegram) ---
# Uses Groq Whisper with GROQ_API_KEY (or the visitor's own Groq key in Settings on the website).
# KM_STT_MODEL=whisper-large-v3-turbo
KM_STT_MODEL=
