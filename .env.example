# Walrus Memory — generate both at https://staging.memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz

# Embedding distance above which a recalled memory is treated as noise and kept
# out of the prompt. Default 0.6. Raise it if the agent is missing facts it
# should know; lower it if unrelated entries are reaching the model. Distances
# are not portable across relayer versions, so this is a dial, not a constant.
KM_RELEVANCE_DISTANCE=

# Sui contract ids for delegate-key registration (from the Walrus Memory dashboard)
MEMWAL_PACKAGE_ID=
MEMWAL_REGISTRY_ID=

# Enoki zkLogin — https://portal.enoki.mystenlabs.com
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

OPENAI_API_KEY=

# Dev only: skip Enoki and pin a fake owner address so the memory flow is testable
DEV_FAKE_ADDRESS=

# Session cookie signing key — any long random string
SESSION_SECRET=

# MCP server: whose memory it speaks for (a Sui address)
KM_OWNER_ADDRESS=

# The origin the browser actually loads the app from. Enoki sends
# "<this>/signin" to Google as the OAuth redirect_uri, and Google matches it
# verbatim against the registered list. Leave blank locally to use the current
# origin; set it in deployments where the public URL differs.
NEXT_PUBLIC_APP_URL=

# Sui network for zkLogin. Must be the same value the Enoki wallet is
# registered with and the one the server verifies proofs against — a testnet
# proof checked against mainnet is rejected as an invalid signature.
# Defaults to testnet when unset.
NEXT_PUBLIC_SUI_NETWORK=testnet
