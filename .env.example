# Walrus Memory — generate both at https://staging.memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz

# Embedding distance above which a recalled memory is treated as noise and kept
# out of the prompt. Default 0.6. Raise it if the agent is missing facts it
# should know; lower it if unrelated entries are reaching the model. Distances
# are not portable across relayer versions, so this is a dial, not a constant.
KM_RELEVANCE_DISTANCE=

# Sui contract ids for delegate-key registration (from the Walrus Memory dashboard)
MEMWAL_PACKAGE_ID=
MEMWAL_REGISTRY_ID=

# Each person creates their OWN MemWal account at /setup (their wallet signs; the
# server only ever holds a revocable delegate key). The MEMWAL_PRIVATE_KEY /
# MEMWAL_ACCOUNT_ID pair above then serves only scripts and the MCP server.
# Set to 1 ONLY for a single-tenant demo where one server-held account serves
# every visitor - the model that makes "you own your memory" false.
MEMWAL_SHARED_ACCOUNT=

# Enoki zkLogin — https://portal.enoki.mystenlabs.com
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Model providers — OPTIONAL. Anyone using the app can add their own key in
# Settings instead; a key set here is a fallback for every visitor and is spent
# on your account. Set KM_MODEL_PROVIDER to pin one when several are present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
KM_MODEL_PROVIDER=

# Model overrides. By default ONE model does both jobs: it answers the person
# and it reads each turn for facts worth remembering. They used to be split,
# and a gate running on a model nobody chose failed silently on every turn.
# Set KM_EXTRACT_MODEL only if you want the cheap tier back for the gate.
KM_CHAT_MODEL=
KM_EXTRACT_MODEL=

# Session cookie signing key — any long random string
SESSION_SECRET=

# MCP server: whose memory it speaks for (a Sui address)
KM_OWNER_ADDRESS=

# The origin the browser actually loads the app from. Enoki sends
# "<this>/signin" to Google as the OAuth redirect_uri, and Google matches it
# verbatim against the registered list. Leave blank locally to use the current
# origin; set it in deployments where the public URL differs.
NEXT_PUBLIC_APP_URL=

# Sui network for zkLogin. Must be the same value the Enoki wallet is
# registered with and the one the server verifies proofs against — a testnet
# proof checked against mainnet is rejected as an invalid signature.
# Defaults to testnet when unset.
NEXT_PUBLIC_SUI_NETWORK=testnet

# Composio — https://platform.composio.dev. One API key for the app; each
# person connects their OWN Telegram / Google Calendar, keyed by their Sui
# address, so tokens never mix between people.
COMPOSIO_API_KEY=
# Auth config ids from the Composio dashboard (one per toolkit).
COMPOSIO_TELEGRAM_AUTH_CONFIG_ID=
COMPOSIO_GOOGLECALENDAR_AUTH_CONFIG_ID=

# Reminders — the one small non-Walrus store (chat id, push subscription, queued
# meal names + times). Upstash Redis REST, or Vercel's KV integration (same
# variables). Without these dev uses process memory and production refuses.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram — direct Bot API. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; registered with setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Web Push — `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Scheduler: .github/workflows/reminders.yml calls GET /api/cron/reminders with
# "Authorization: Bearer $CRON_SECRET". Set the same value as a repo secret.
CRON_SECRET=
